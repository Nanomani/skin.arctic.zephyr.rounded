                    <onclick condition="Skin.HasSetting(hide.furniture.nowplaying.home)">Skin.Reset(show.furniture.nowplaying.extended.home)</onclick>
                    <onclick condition="Skin.HasSetting(hide.furniture.nowplaying.home)">Skin.Reset(hide.furniture.nowplaying.home)</onclick>
                    <onclick>SetProperty(reloadskin,1,Home)</onclick>
                </control>

                <!-- SHOW PLAYER OSD BUTTON -->

                <control type="radiobutton" id="97428">
                    <include>Def_Dialog_Menu_Button_Focus_Select</include>
                    <label>$LOCALIZE[31451]</label>
