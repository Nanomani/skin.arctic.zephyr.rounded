        <button id="9412" property="widgetSortby" type="toggle" />
        <button id="9411" property="widgetClearLogoFanart" type="toggle" requires="widget" />
    </buttons>

    <!-- Fallback values -->
    <fallbacks>
        <fallback property="widgetaspect">
            <default>Poster</default>
        </fallback>
        <fallback property="widgetTarget">
            <default>videos</default>
        </fallback>
    </fallbacks>
</properties>
