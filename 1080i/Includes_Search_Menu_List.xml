<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="Furniture_Menu_Search">
        <control type="group">
            <visible>!String.IsEmpty(Window(Home).Property(Show_Menu_Search)) + !Control.HasFocus(90009) + !Control.HasFocus(330) + !Control.HasFocus(340) + !Window.IsVisible(DialogBusy.xml)</visible>

            <include>Animation_Common_Fade_In</include>
            <include>Animation_Common_Fade_Out</include>

            <!-- <include content="Animation_Common_Context_Menu_Slide_Left"><param name="left" value="-490" /></include> -->

            <top>160</top>
            <centerleft>305</centerleft>
            <width>450</width>

            <!-- ARROWS -->

            <include content="Object_Arrows_Dialog_Vertical">
                <param name="container_id" value="3060" />
            </include>

            <!-- BACKGROUND -->

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="199" />
                <param name="visible" value="Integer.IsEqual(Container(3060).NumItems,1)" />
            </include>

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="269" />
                <param name="visible" value="Integer.IsEqual(Container(3060).NumItems,2)" />
            </include>

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="339" />
                <param name="visible" value="Integer.IsEqual(Container(3060).NumItems,3)" />
            </include>

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="409" />
                <param name="visible" value="Integer.IsEqual(Container(3060).NumItems,4)" />
            </include>

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="479" />
                <param name="visible" value="Integer.IsEqual(Container(3060).NumItems,5)" />
            </include>

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="549" />
                <param name="visible" value="Integer.IsEqual(Container(3060).NumItems,6)" />
            </include>

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="619" />
                <param name="visible" value="Integer.IsEqual(Container(3060).NumItems,7)" />
            </include>

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="689" />
                <param name="visible" value="Integer.IsEqual(Container(3060).NumItems,8)" />
            </include>

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="759" />
                <param name="visible" value="Integer.IsEqual(Container(3060).NumItems,9)" />
            </include>

            <include content="Def_Dialog_Multi_Row_Background">
                <param name="height" value="829" />
                <param name="visible" value="Integer.IsGreater(Container(3060).NumItems,9)" />
            </include>

            <include content="Def_Dialog_Header">
                <param name="label" value="137" />
                <param name="icon" value="search" />
            </include>

            <!-- LIST POWER MENU -->

            <control type="list" id="3060">
                <include>Animation_Scrolltime_Views_List</include>

                <top>112</top>
                <left>16</left>
                <height min="100" max="700">auto</height>
                <width>418</width>
                <bottom>17</bottom>

                <onup>3060</onup>
                <ondown>3060</ondown>

                <onback>SetFocus(399)</onback>
                <onback>ClearProperty(Show_Menu_Search,Home)</onback>

                <onleft>SetFocus(399)</onleft>
                <onleft>ClearProperty(Show_Menu_Search,Home)</onleft>

                <onright>SetFocus(399)</onright>
                <onright>ClearProperty(Show_Menu_Search,Home)</onright>

                <!-- <onright>1799</onright> -->

                <pagecontrol>1799</pagecontrol>
                <orientation>vertical</orientation>

                <itemlayout width="418" height="70">
                    <control type="image">
                        <top>8</top>
                        <left>16</left>
                        <width>56</width>
                        <height>56</height>
                        <texture colordiffuse="$VAR[Color_Icon_Menu_List]">$INFO[Container(300).ListItem.Icon]</texture>
                    </control>
                    <control type="label">
                        <left>84</left>
                        <align>left</align>
                        <aligny>center</aligny>
                        <width>74%</width>
                        <height>100%</height>
                        <centertop>50%</centertop>
                        <font>Tiny</font>
                        <textcolor>Dark2</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="418" height="70">

                    <!-- ITEM FOCUS -->

                    <include content="Def_Layout_Item_Focus">
                        <param name="visible" value="Control.HasFocus(3060)" />
                    </include>

                    <control type="image">
                        <top>8</top>
                        <left>16</left>
                        <width>56</width>
                        <height>56</height>
                        <texture colordiffuse="Selected">$INFO[Container(300).ListItem.Icon]</texture>
                        <visible>Control.HasFocus(3060)</visible>
                    </control>
                    <control type="label">
                        <left>84</left>
                        <align>left</align>
                        <aligny>center</aligny>
                        <width>74%</width>
                        <height>100%</height>
                        <centertop>50%</centertop>
                        <font>Tiny</font>
                        <textcolor>Selected</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>Control.HasFocus(3060)</visible>
                    </control>
                    <control type="image">
                        <top>8</top>
                        <left>16</left>
                        <width>56</width>
                        <height>56</height>
                        <texture colordiffuse="$VAR[Color_Icon_Menu_List]">$INFO[Container(300).ListItem.Icon]</texture>
                        <visible>!Control.HasFocus(3060)</visible>
                    </control>
                    <control type="label">
                        <left>84</left>
                        <align>left</align>
                        <aligny>center</aligny>
                        <width>74%</width>
                        <height>100%</height>
                        <centertop>50%</centertop>
                        <font>Tiny</font>
                        <textcolor>Dark2</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!Control.HasFocus(3060)</visible>
                    </control>
                </focusedlayout>

                <!-- SKINSHORTCUTS -->

                <content>
                    <include>skinshortcuts-searchmenulist</include>
                </content>
            </control>
        </control>
    </include>
</includes>
