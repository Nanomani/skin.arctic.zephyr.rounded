            <option value="ThumbnailSmall" label="$LOCALIZE[31474]" condition="!widgetPath~Weather" />
            <option value="Square" label="$LOCALIZE[31191]" />
            <option value="SquareMiddle" label="$LOCALIZE[31309]" condition="!widgetPath~Weather" />
