<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1129">
    <defaultcontrol always="true">6090</defaultcontrol>

    <onload>SetFocus(6090)</onload>

    <onload>ClearProperty(OSDRelaunchPlaylist,Home)</onload>
    <onload>SetProperty(TMDbHelper.WidgetContainer,6090,Home)</onload>
    <onunload>ClearProperty(TMDbHelper.WidgetContainer,Home)</onunload>

    <include>Animation_Common_Fade_In</include>
    <include>Animation_Common_Fade_Out</include>

    <controls>

        <!-- TITLE 2 -->

        <control type="label">
            <top>60</top>
            <left>88</left>
            <aligny>center</aligny>
            <height>64</height>
            <font>Small24</font>
            <label>$VAR[Label_OSD_Playlist_Title_Left]</label>
            <textcolor>$VAR[Color_OSD_Panel_White70]</textcolor>
            <selectedcolor>$VAR[Color_OSD_Panel_White70]</selectedcolor>
        </control>

        <!-- TITLE 2 -->

        <control type="label">
            <top>60</top>
            <left>560</left>
            <aligny>center</aligny>
            <height>64</height>
            <font>Small24</font>
            <label>$VAR[Label_OSD_Playlist_Title_Right]</label>
            <textcolor>$VAR[Color_OSD_Panel_White70]</textcolor>
            <selectedcolor>$VAR[Color_OSD_Panel_White70]</selectedcolor>
        </control>

        <!-- LINE HORIZONTAL -->

        <control type="image">
            <top>113</top>
            <left>80</left>
            <right>80</right>
            <height>1</height>
            <include content="Texture_Dialog_Line">
                <param name="colordiffuse" value="$VAR[Color_OSD_Dialog_Border]" />
            </include>
        </control>

        <!-- LEFT MENU -->

        <control type="group">
            <top>130</top>
            <left>80</left>
            <width>450</width>
            <height>457</height>

            <!-- ARROWS -->

            <include content="Object_Arrows_Dialog_Horizontal">
                <param name="top" value="467" />
                <param name="container_id" value="6090" />
                <param name="colordiffuse" value="Dark3" />
                <param name="numitems" value="5" />
            </include>

            <!-- LIST MENU SEARCH -->

            <control type="list" id="6090">
                <include>Animation_Scrolltime_Views_List</include>

                <top>0</top>
                <left>0</left>
                <height>457</height>
                <width>450</width>

                <onleft>Close</onleft>
                <onright>6092</onright>
                <onright>SetProperty(TMDbHelper.WidgetContainer,6092,Home)</onright>

                <onclick condition="String.IsEmpty(Window(Home).Property(OSDRelaunchFullscreen))">SetProperty(OSDRelaunchFullscreen,1,Home)</onclick>
                <onclick condition="String.IsEmpty(Window(Home).Property(OSDRelaunchPlaylist))">SetProperty(OSDRelaunchPlaylist,1,Home)</onclick>
                <onclick condition="String.IsEmpty(Container(6090).ListItem.Property(folderpath))">AlarmClock(LaunchPlayMedia,PlayMedia($ESCINFO[Container(6090).ListItem.FolderPath],isdir,playoffset=$INFO[Window(Home).Property(OSDRelaunchFullscreen)]),00:00,silent)</onclick>
                <onclick condition="!String.IsEmpty(Container(6090).ListItem.Property(folderpath))">AlarmClock(LaunchPlayMedia,PlayMedia($ESCINFO[Container(6090).ListItem.Property(folderpath)],isdir,playoffset=$INFO[Window(Home).Property(OSDRelaunchFullscreen)]),00:00,silent)</onclick>

                <orientation>vertical</orientation>
                <focusposition>1</focusposition>

                <itemlayout height="91.4" width="450">
                    <include>layout_list_item_music_osd</include>
                </itemlayout>
                <focusedlayout height="91.4" width="450">
                    <include content="layout_list_focus_music_osd">
                        <param name="list_id" value="6090" />
                    </include>
                </focusedlayout>

                <!-- PLAYLIST MUSIC -->

                <content>
                    <item>
                        <label>$LOCALIZE[559]</label>
                        <icon>special://skin/extras/icons/playlist.png</icon>
                        <property name="folderpath">playlistmusic://</property>
                    </item>
                </content>

                <!-- LIST ALBUM - ARTIST NOW PLAYING -->

                <content>$VAR[Def_Player_Artist_List_Albums]</content>
            </control>
        </control>

        <!-- COLUMN 1 -->

        <control type="group">
            <top>130</top>
            <left>540</left>

            <!-- LIST ITEM -->

            <control type="panel" id="6092">
                <include>Animation_Scrolltime_Views_List</include>

                <top>0</top>
                <left>12</left>
                <height>457</height>
                <width>1294</width>

                <onback>6090</onback>
                <onleft>6090</onleft>
                <onleft>SetProperty(TMDbHelper.WidgetContainer,6090,Home)</onleft>
                <onright>1899</onright>

                <onclick>SetProperty(OSDRelaunchFullscreen,$INFO[Container(6092).CurrentItem],Home)</onclick>

                <onclick condition="String.IsEmpty(Window(Home).Property(OSDRelaunchPlaylist))">SetProperty(OSDRelaunchPlaylist,1,Home)</onclick>

                <onclick>SetFocus(6090)</onclick>

                <onclick>Action(Select)</onclick>

                <pagecontrol>1899</pagecontrol>
                <orientation>vertical</orientation>

                <focusposition>1</focusposition>

                <itemlayout height="91.4" width="647">
                    <control type="group">
                        <width>627</width>
                        <include>layout_list_item_music_osd</include>
                    </control>
                </itemlayout>
                <focusedlayout height="91.4" width="647">
                    <control type="group">
                        <width>627</width>
                        <include content="layout_list_focus_music_osd">
                            <param name="list_id" value="6092" />
                            <param name="visible" value="Control.HasFocus(6092) | Control.HasFocus(1899) | Control.HasFocus(6094) | Control.HasFocus(1999)" />
                        </include>
                    </control>
                </focusedlayout>

                <!-- LIST ALBUM -->

                <content>$VAR[Path_MusicOSD_TrackList_Col1]</content>
            </control>

            <!-- SCROLLBAR -->

            <include content="Object_Scrollbar_Dialog_Vertical">
                <param name="colordiffuse_texturesliderbackground" value="E62D2E2E" />
                <param name="colordiffuse_texturesliderbar" value="4DC5C5C5" />
                <param name="colordiffuse_texturesliderbarfocus" value="$VAR[Color_OSD_Slider_Nib_Focus]" />
                <param name="scrollid" value="1899" />
                <param name="top" value="0" />
                <param name="onback" value="6092" />
                <param name="onleft" value="6092" />
                <param name="onright" value="6092" />
                <param name="height" value="457" />
                <param name="centerright" value="80" />
                <param name="animation_fade_hide" value="false" />
            </include>
        </control>
    </controls>
</window>
