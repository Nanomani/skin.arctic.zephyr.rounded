            <textcolor>Dark1</textcolor>
            <selectedcolor>Dark1</selectedcolor>
            <label>$VAR[Label_View_List_Label]</label>
        </control>

        <!-- DURATION -->

        <control type="label">
            <animation effect="slide" start="0" end="60" time="0" condition="Skin.HasSetting(hide.markers)">Conditional</animation>
            <animation effect="slide" start="0" end="66" time="0" condition="Skin.HasSetting(hide.video.ratings)">Conditional</animation>
            <right>154</right>
            <width>500</width>
            <aligny>center</aligny>
            <height>64</height>
            <align>right</align>
            <font>SmallNavi</font>
            <textcolor>Dark1</textcolor>
            <selectedcolor>Dark1</selectedcolor>
            <label>$VAR[Label_Duration_Format_List]</label>
        </control>

        <!-- WATCHED STATUS -->

        <control type="label">
            <animation effect="slide" start="0" end="60" time="0" condition="Skin.HasSetting(hide.markers)">Conditional</animation>
            <animation effect="slide" start="0" end="66" time="0" condition="Skin.HasSetting(hide.video.ratings)">Conditional</animation>
            <align>right</align>
            <aligny>center</aligny>
            <width>64</width>
            <centerright>130</centerright>
            <height>68</height>
            <font>SymbolList</font>
            <label>$VAR[Label_List_Watched]</label>
            <visible>!ListItem.IsParentFolder</visible>
            <visible>!Skin.HasSetting(hide.markers)</visible>
        </control>

        <!-- RATING -->

        <control type="label">
            <right>30</right>
            <width>500</width>
            <aligny>center</aligny>
            <height>64</height>
            <align>right</align>
            <font>SmallNavi</font>
            <textcolor>Dark1</textcolor>
            <selectedcolor>Dark1</selectedcolor>
            <label>$VAR[Label_View_List_Rating]</label>
            <visible>!Skin.HasSetting(hide.video.ratings)</visible>
        </control>
    </include>

