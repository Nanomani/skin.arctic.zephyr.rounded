<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="View_59_BannerWall">
        <description>List View (id=59)</description>
        <control type="group">
            <visible>Control.IsVisible(59)</visible>
            <include>Animation_Common_Global</include>

            <include condition="!Skin.HasSetting(show.clock.date.weather.home.only) + !Skin.HasSetting(show.furniture.footer)">Furniture_Footer_Clock_Right</include>

            <control type="panel" id="59">
                <visible>$EXP[Exp_View_59]</visible>
                <include>Animation_Scrolltime_Views_List</include>

                <top>200</top>
                <left>View_Poster_Side</left>
                <height>View_Poster_height</height>

                <include content="Def_Layout_Action_On_Left_On_Right" >
                    <param name="scrollid" value="1619" />
                </include>

                <onup>59</onup>
                <ondown>59</ondown>

                <preloaditems>2</preloaditems>
                <pagecontrol>1619</pagecontrol>

                <viewtype label="31574">list</viewtype>

                <!-- WALL ONLY -->

                <itemlayout height="133" width="593" condition="!Skin.HasSetting(59.show.info)">
                    <control type="group">
                        <top>5</top>
                        <height>128</height>
                        <width>590</width>
                        <include content="Layout_Widget_Banner">
                            <param name="texture_diffuse" value="banner_w574_h108" />
                            <param name="id" value="59" />
                            <param name="height" value="128" />
                        </include>
                    </control>
                </itemlayout>
                <focusedlayout height="133" width="593" condition="!Skin.HasSetting(59.show.info)">
                    <control type="group">
                        <top>5</top>
                        <height>128</height>
                        <width>590</width>
                        <include content="Layout_Widget_Banner_Focus">
                            <param name="texture_diffuse" value="banner_w574_h108" />
                            <param name="id" value="59" />
                            <param name="height" value="128" />
                            <param name="glow_height" value="135" />
                            <param name="glow_top" value="-4" />
                            <param name="glow_left" value="11" />
                            <param name="glow_right" value="13" />
                        </include>
                    </control>
                </focusedlayout>

                <!-- SHOW INFOS -->

                <itemlayout height="335" width="593" condition="Skin.HasSetting(59.show.info)">
                    <include content="Def_Art_Full_Background_b12">
                        <param name="pad_shadow" value="1" />
                        <param name="pad_border" value="1" />
                        <param name="pad_image" value="10" />
                        <param name="colordiffuse" value="White100" />
                    </include>
                    <control type="group">
                        <height>128</height>
                        <width>593</width>
                        <include content="Layout_Widget_Banner">
                            <param name="texture_diffuse" value="banner_w574_h108" />
                            <param name="id" value="59" />
                            <param name="height" value="128" />
                            <param name="visible_shadow" value="false" />
                        </include>
                    </control>
                    <control type="label">
                        <top>130</top>
                        <left>40</left>
                        <right>40</right>
                        <height>50</height>
                        <align>left</align>
                        <font>SmallBold</font>
                        <textcolor>Dark1</textcolor>
                        <selectedcolor>Dark1</selectedcolor>
                        <label>$VAR[Label_View_List_Label]</label>
                    </control>
                    <control type="textbox">
                        <top>190</top>
                        <left>40</left>
                        <right>40</right>
                        <height>80</height>
                        <align>left</align>
                        <font>Tiny</font>
                        <autoscroll>false</autoscroll>
                        <textcolor>Dark2</textcolor>
                        <selectedcolor>Dark2</selectedcolor>
                        <label>$VAR[Label_Plot_Box_Video_Music]</label>
                    </control>
                    <control type="label">
                        <left>40</left>
                        <right>40</right>
                        <bottom>25</bottom>
                        <aligny>center</aligny>
                        <height>38</height>
                        <align>right</align>
                        <font>InfoNetflix</font>
                        <textcolor>Dark2</textcolor>
                        <selectedcolor>Dark2</selectedcolor>
                        <visible>!ListItem.IsParentFolder</visible>
                        <label>$VAR[Label_View_Card_58_59_515_Footer_Info]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="335" width="593" condition="Skin.HasSetting(59.show.info)">
                    <include content="Def_Art_Full_Background_b12">
                        <param name="pad_shadow" value="1" />
                        <param name="pad_border" value="1" />
                        <param name="pad_image" value="10" />
                        <param name="colordiffuse" value="White100" />
                    </include>

                    <include content="Def_Image_Background_Only_b12">
                        <param name="pad_image" value="10" />
                        <param name="colordiffuse_background" value="PanelWhite70" />
                    </include>

                    <control type="group">
                        <height>128</height>
                        <width>593</width>
                        <include content="Layout_Widget_Banner">
                            <param name="texture_diffuse" value="banner_w574_h108" />
                            <param name="id" value="59" />
                            <param name="height" value="128" />
                            <param name="visible_shadow" value="false" />
                        </include>
                    </control>
                    <control type="label">
                        <top>130</top>
                        <left>40</left>
                        <right>40</right>
                        <height>50</height>
                        <align>left</align>
                        <font>SmallBold</font>
                        <textcolor>Light1</textcolor>
                        <selectedcolor>Light1</selectedcolor>
                        <label>$VAR[Label_View_List_Label]</label>
                    </control>
                    <control type="textbox">
                        <top>190</top>
                        <left>40</left>
                        <right>40</right>
                        <height>114</height>
                        <align>left</align>
                        <font>Tiny</font>
                        <textcolor>Light2</textcolor>
                        <selectedcolor>Light2</selectedcolor>
                        <autoscroll delay="5000" time="3000" repeat="5000">true</autoscroll>
                        <label>$VAR[Label_Plot_Box_Video_Music]</label>
                    </control>
                </focusedlayout>
            </control>

            <!-- SCROLLBAR -->

            <include content="Def_Layout_Scrollbar_Vertical" >
                <param name="scrollid" value="1619" />
                <param name="idlayout" value="59" />
            </include>
        </control>
    </include>
</includes>
