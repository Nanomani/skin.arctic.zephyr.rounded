<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="DoubleView511Banner">
        <control type="panel" id="512">
            <visible>$EXP[Exp_View_512]</visible>
            <include>Animation_Scrolltime_Views_Poster</include>
            <animation effect="slide" start="0,0" end="675,0" time="200" condition="Skin.HasSetting(flip512rightleft)">Conditional</animation>

            <top>304</top>
            <left>View_Poster_Side</left>
            <width>1122</width>
            <height>580</height>

            <include content="Def_Layout_Action_On_Left_On_Right" >
                <param name="scrollid" value="1691" />
            </include>

            <orientation>vertical</orientation>
            <preloaditems>2</preloaditems>
            <pagecontrol>1691</pagecontrol>

            <viewtype label="31064">list</viewtype>

            <itemlayout height="289" width="184">
                <control type="group">
                    <height>271</height>
                    <include content="Layout_Widget_Poster">
                        <param name="texture_diffuse" value="poster_w164_h251" />
                        <param name="id" value="512" />
                        <param name="height" value="271" />
                    </include>
                </control>
            </itemlayout>
            <focusedlayout height="289" width="184">
                <control type="group">
                    <height>271</height>
                    <include content="Layout_Widget_Poster_Focus">
                        <param name="texture_diffuse" value="poster_w164_h251" />
                        <param name="id" value="512" />
                        <param name="height" value="271" />
                        <param name="glow_height" value="267" />
                    </include>
                </control>
            </focusedlayout>
        </control>
    </include>

    <include name="Control_512_List_Info_Video_List">
        <control type="list" id="512">
            <include>Layout_512_List_Info_Video</include>
        </control>
    </include>

    <include name="Control_512_List_Info_Video_Fixed_List">
        <control type="fixedlist" id="512">
            <include>Layout_512_List_Info_Video</include>
        </control>
    </include>

    <include name="Layout_512_List_Info_Video">
        <visible>$EXP[Exp_View_512]</visible>
        <include>Animation_Scrolltime_Views_List</include>
        <animation effect="slide" start="0,0" end="690,0" time="200" condition="Skin.HasSetting(flip512rightleft)">Conditional</animation>

        <top>314</top>
        <left>View_List_Side</left>
        <width>1092</width>
        <height>540</height>

        <include content="Def_Layout_Action_On_Left_On_Right" >
            <param name="scrollid" value="1691" />
        </include>

        <orientation>vertical</orientation>
        <preloaditems>2</preloaditems>
        <pagecontrol>1691</pagecontrol>

        <focusposition>1</focusposition>

        <include content="Def_Focus_Position" condition="!Skin.HasSetting(51x.list.control.list)">
            <param name="focusposition" value="1" />
        </include>
        <include content="Def_Movement" condition="!Skin.HasSetting(enable.view.5x.51x.extended.list) + !Skin.HasSetting(51x.list.control.list)">
            <param name="movement" value="6" />
        </include>
        <include content="Def_Movement" condition="Skin.HasSetting(enable.view.5x.51x.extended.list) + !Skin.HasSetting(51x.list.control.list)">
            <param name="movement" value="4" />
        </include>

        <viewtype label="31064">list</viewtype>

        <itemlayout condition="!Skin.HasSetting(enable.view.5x.51x.extended.list)" width="1070" height="67.5">
            <include>layout_list_item_video</include>
        </itemlayout>
        <focusedlayout condition="!Skin.HasSetting(enable.view.5x.51x.extended.list)" width="1070" height="67.5">
            <include content="layout_list_focus_video"><param name="list_id" value="512" /></include>
        </focusedlayout>

        <itemlayout condition="Skin.HasSetting(enable.view.5x.51x.extended.list)" width="1070" height="90">
            <include>layout_list_item_video_info</include>
        </itemlayout>
        <focusedlayout condition="Skin.HasSetting(enable.view.5x.51x.extended.list)" width="1070" height="90">
            <include content="layout_list_focus_video_info"><param name="list_id" value="512" /></include>
        </focusedlayout>
    </include>

    <include name="View_512_Double_Banner">
        <description>List View (id=512)</description>
        <control type="group">
            <visible>Control.IsVisible(512)</visible>
            <include>Animation_Common_Global</include>

            <include condition="!Skin.HasSetting(show.clock.date.weather.home.only) + !Skin.HasSetting(show.furniture.footer)">Furniture_Footer_Clock_Right</include>

            <control type="group">
                <animation effect="slide" start="0,0" end="0,-20" time="200" condition="Skin.HasSetting(show.view.511.title.clearlogo)">Conditional</animation>

                <top>-50</top>
                <left>0</left>
                <width>1920</width>

                <control type="image" description="clearlogo">
                    <visible>Skin.HasSetting(show.view.511.title.clearlogo) + $EXP[Title_Clearlogo_Available]</visible>
                    <top>255</top>
                    <height>ClearLogoTitleMaxHeight</height>
                    <width>ClearLogoTitleMaxWidth</width>
                    <centerleft>50%</centerleft>
                    <aspectratio scalediffuse="true" align="center">keep</aspectratio>
                    <texture background="true">$VAR[Image_Crop_ClearLogo]</texture>
                    <fadetime>ClearArtFadetime</fadetime>
                </control>
                <control type="label">
                    <visible>!Skin.HasSetting(show.view.511.title.clearlogo) | [Skin.HasSetting(show.view.511.title.clearlogo) + !$EXP[Title_Clearlogo_Available]]</visible>
                    <top>260</top>
                    <align>center</align>
                    <description>Header Label</description>
                    <textcolor>Dark1</textcolor>
                    <font>LargeNew</font>
                    <label fallback="19055">$INFO[ListItem.Title]</label>
                </control>
            </control>
            <control type="group">
                <animation effect="slide" start="0,0" end="-1096,0" time="200" condition="Skin.HasSetting(flip512rightleft)">Conditional</animation>

                <top>301</top>
                <right>104</right>
                <width>638</width>
                <height>545</height>

                <control type="group">
                    <animation effect="slide" start="0,0" end="0,153" time="200" condition="Skin.HasSetting(Flip512)">Conditional</animation>
                    <animation effect="slide" start="0,0" end="0,4" time="200" condition="Skin.HasSetting(enable.view.5x.51x.extended.list) + Skin.HasSetting(Flip512) + Skin.HasSetting(ListView511)">Conditional</animation>

                    <top>14</top>
                    <width>662</width>
                    <height>381</height>

                    <include content="Def_Art_Full_Background_b24">
                        <param name="colordiffuse" value="Fallback" />
                    </include>

                    <control type="image">
                        <width>100%</width>
                        <height>100%</height>
                        <fadetime>PosterFanartFadetime</fadetime>
                        <aspectratio aligny="center" align="center" scalediffuse="false">scale</aspectratio>
                        <texture diffuse="diffuse/fanart_w662_h381_b24.png" background="true">$VAR[Image_Fanart_View_50x]</texture>
                    </control>
                </control>

                <!-- BANNER -->

                <control type="group">
                    <animation effect="slide" start="0,0" end="0,-413" time="200" condition="Skin.HasSetting(Flip512)">Conditional</animation>

                    <top>427</top>
                    <width>662</width>
                    <height>125</height>

                    <include>Def_Art_Full_Background_b12</include>

                    <control type="image">
                        <width>100%</width>
                        <height>100%</height>
                        <fadetime>PosterFanartFadetime</fadetime>
                        <aspectratio aligny="center" align="center" scalediffuse="false">scale</aspectratio>
                        <texture diffuse="diffuse/banner_w662_h125.png" background="true">$VAR[Image_Banner]</texture>
                    </control>

                    <!-- CLEARLOGO -->

                    <control type="image">
                        <width>500</width>
                        <right>30</right>
                        <bottom>30</bottom>
                        <top>30</top>
                        <fadetime>PosterFanartFadetime</fadetime>
                        <aspectratio align="right" aligny="bottom">keep</aspectratio>
                        <texture background="true">$VAR[Image_ClearLogo]</texture>
                        <visible>String.IsEmpty(ListItem.Art(banner)) + String.IsEmpty(ListItem.Art(tvshow.banner))</visible>
                    </control>
                </control>
            </control>

            <include condition="Skin.HasSetting(ListView511) + !Skin.HasSetting(51x.list.control.list)">Control_512_List_Info_Video_Fixed_List</include>
            <include condition="Skin.HasSetting(ListView511) + Skin.HasSetting(51x.list.control.list)">Control_512_List_Info_Video_List</include>
            <include condition="!Skin.HasSetting(ListView511)">DoubleView511Banner</include>

            <!-- SCROLLBAR -->

            <include content="Def_Layout_Scrollbar_Vertical" >
                <param name="scrollid" value="1691" />
                <param name="idlayout" value="512" />
                <param name="top" value="315" />
                <param name="height" value="534" />
            </include>
        </control>
    </include>
</includes>
