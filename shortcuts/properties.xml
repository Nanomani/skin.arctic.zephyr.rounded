    </property>

    <!-- Button mappings -->
    <buttons>
        <!-- Widget picker -->
        <button id="4001" property="widget" type="widget" />

        <!-- Background picker -->
        <button id="310" property="background" type="background" />

        <!-- Widget options (all require widget to be set) -->
        <button id="9901" property="widgetaspect" title="$LOCALIZE[31189]" requires="widget" showNone="false" />
        <button id="9902" property="widgetTarget" title="$LOCALIZE[31559]" requires="widget" />
        <button id="9903" property="widgetSortby" title="$LOCALIZE[581]" requires="widget" />
