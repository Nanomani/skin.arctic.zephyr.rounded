                    <onclick>Skin.ToggleSetting(hide.home.nowplaying.extended.osd.control.button)</onclick>
                    <onclick condition="!Skin.HasSetting(hide.home.nowplaying.extended.osd.control.button)">Skin.Reset(hide.home.menu.with.nowplaying.extended)</onclick>
                    <visible>Skin.HasSetting(show.furniture.nowplaying.extended.home)</visible>
                </control>

                <!-- HIDE HOME MENU AND HEADER -->

                <control type="radiobutton" id="98095">
                    <include>Def_Dialog_Menu_Button_Focus_Select</include>
                    <label>$LOCALIZE[31495]</label>
                    <selected>Skin.HasSetting(hide.home.menu.with.nowplaying.extended)</selected>
                    <onclick>Skin.ToggleSetting(hide.home.menu.with.nowplaying.extended)</onclick>
                    <onclick>Skin.Reset(hide.home.nowplaying.extended.osd.control.button)</onclick>
