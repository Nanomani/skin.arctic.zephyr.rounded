<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1148">
    <defaultcontrol always="true">90009</defaultcontrol>


    <onload condition="!String.IsEmpty(Window(Home).Property(CustomSearchTerm))">RunScript(script.skinvariables,set_editcontrol=90009,window_id=1148,setfocus=340,text=$INFO[Window(Home).Property(CustomSearchTerm)])</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(CustomSearchTerm)) + !String.IsEqual(Window(Home).Property(ReplaceWindow),1148)">ClearProperty(CustomSearchTerm,Home)</onload>

    <onunload>ClearProperty(TMDbHelper.WidgetContainer,Home)</onunload>

    <onload>SetFocus(90009)</onload>

	<controls>
        <include>Background_Global</include>

        <control type="group">
            <animation effect="slide" start="0" end="0,-40" time="0" condition="true">Conditional</animation>

            <include>Animation_Common_Fade_In</include>
            <include>Animation_Common_Fade_Out</include>

            <control type="group">
                <visible>!$EXP[View_Info_Dialog] + !Control.HasFocus(9992)</visible>
                <include>Animation_Feature_NowPlaying</include>
                <include condition="!Skin.HasSetting(hide.furniture.nowplaying.views)">Furniture_Header_NowPlaying</include>
            </control>
        </control>

        <control type="group">
            <!-- <animation effect="slide" start="0" end="0,30" time="0" condition="true">Conditional</animation> -->
            <include condition="!Skin.HasSetting(show.home.header.clock.left)">Furniture_Footer_Clock_Right</include>
        </control>

        <!-- WIDGET TITLE DETAIL -->

        <include condition="!Skin.HasSetting(disable.all.hidden.list)">Hidden_List_Home_Artist_Album_Count</include>
        <include condition="!Skin.HasSetting(disable.all.hidden.list)">Hidden_List_Home_Album_Song_Count</include>
        <include condition="!Skin.HasSetting(disable.all.hidden.list)">Hidden_List_Home_Album_Item_Name_In_Folder</include>
        <include condition="!Skin.HasSetting(disable.all.hidden.list)">Hidden_List_Home_Set_Count</include>

        <!-- SEARCH BAR -->

        <control type="group">
            <visible allowhiddenfocus="true">!Window.IsVisible(DialogSelect.xml) + !Window.IsVisible(script-wikipedia.xml)</visible>

            <animation effect="fade" time="300" start="0" end="0">Focus</animation>

            <!-- SEARCH BAR -->

            <control type="group">
                <visible>Control.HasFocus(90009)</visible>

                <top>40</top>
                <left>80</left>
                <width>80</width>
                <height>80</height>

                <control type="image">
                    <width>590</width>
                    <height>80</height>
                    <include>Texture_Bar_Search_Focus</include>
                </control>
                <control type="image">
                    <top>-4</top>
                    <left>-4</left>
                    <width>88</width>
                    <height>88</height>
                    <include>Texture_Icon_Search_Focus</include>
                </control>
            </control>
            <control type="group">
                <visible>!Control.HasFocus(90009)</visible>
                <animation effect="fade" start="100" end="50" condition="true">Conditional</animation>

                <top>40</top>
                <left>80</left>
                <width>80</width>
                <height>80</height>

                <control type="image">
                    <width>590</width>
                    <height>80</height>
                    <include>Texture_Bar_Search_NoFocus</include>
                </control>
                <control type="image">
                    <width>590</width>
                    <height>80</height>
                    <texture border="40" colordiffuse="$VAR[Color_Search_Bar_Border]" infill="false">$VAR[border40]</texture>
                </control>
                <control type="image">
                    <top>-4</top>
                    <left>-4</left>
                    <width>88</width>
                    <height>88</height>
                    <include>Texture_Icon_Search_NoFocus</include>
                </control>
            </control>

            <!-- SPINNER LOADING -->

            <control type="group">
                <visible>Window.IsVisible(DialogBusy.xml)</visible>
                <include content="Animation_Common_Delay_Fade_In"><param name="delay" value="200" /></include>

                <top>30</top>
                <left>580</left>

                <width>100</width>
                <height>100</height>

                <include content="Object_Spinner_Busy">
                    <param name="show_label_spinner" value="false" />
                    <param name="show_icon" value="false" />
                    <param name="colordiffuse_progress" value="Selected" />
                    <param name="centerleft" value="50%" />
                    <param name="centertop" value="50%" />
                </include>
            </control>

            <!-- EDIT BAR -->

            <control type="group">
                <top>40</top>
                <left>80</left>

                <control type="edit" id="90009">
                    <width>580</width>
                    <height>80</height>
                    <label/>
                    <align>left</align>
                    <aligny>center</aligny>

                    <font>HeaderLabel</font>
                    <textoffsetx>80</textoffsetx>
                    <textcolor>$VAR[Color_Label_Edit_Search]</textcolor>
                    <focusedcolor>Selected</focusedcolor>
                    <selectedcolor>Selected</selectedcolor>
                    <disabledcolor>White12</disabledcolor>
                    <texturefocus />
                    <texturenofocus />

                    <ondown>SetProperty(PreviousSearchTerm,$INFO[Control.GetLabel(9099).index(1)])</ondown>
                    <ondown condition="!Integer.IsEqual(Container(6000).NumItems,0)">6000</ondown>

                    <onup condition="Integer.IsEqual(Container(6000).NumItems,0)">Close</onup>
                    <ondown condition="Integer.IsEqual(Container(6000).NumItems,0)">Close</ondown>

                    <onright>9992</onright>
                    <onleft>9992</onleft>
                </control>

                <!-- SEARCH ON WIKI -->

                <!-- <control type="button" id="380" description="Helper"> -->
                    <!-- <include>Def_Hidden_Button</include> -->
                    <!-- <onfocus condition="!String.IsEmpty(Control.GetLabel(90009).index(1))">RunScript(script.skinvariables,add_skinstring_history=SearchHistory,value=$INFO[Control.GetLabel(90009).index(1)])</onfocus> -->
                    <!-- <onfocus>SetFocus(90009)</onfocus> -->
                    <!-- <visible allowhiddenfocus="true">Control.HasFocus(380)</visible> -->
                    <!-- <animation effect="fade" time="300" start="0" end="0">Focus</animation> -->
                <!-- </control> -->
            </control>

            <!-- TIPS - FOOTER -->

            <include content="Object_Footer_Tips">
                <param name="top" value="120" />
                <param name="left" value="94" />
                <param name="label" value="$VAR[Label_Feature_Search_Dynamic_Bar_Tip_2]" />
                <param name="label2" value="$VAR[Label_Feature_Search_Dynamic_Bar_Tip]" />
                <param name="id_label" value="88" />
                <param name="textcolor" value="Black70" />
                <param name="colordiffuse" value="$VAR[Color_Icon_Light]" />
                <param name="visible" value="Control.HasFocus(90009) + !$EXP[Dialog_Keyboard_Is_Visible]" />
            </include>
        </control>

        <!-- MINI KEYBOARD -->

        <control type="group">
            <visible allowhiddenfocus="true">Control.HasFocus(9992)</visible>
            <visible>!Window.IsVisible(DialogNotification.xml)</visible>
            <visible>!Window.IsVisible(DialogExtendedProgressBar.xml)</visible>
            <visible>!Window.IsVisible(DialogVolumeBar.xml)</visible>

            <animation effect="fade" time="300" start="0" end="0">Focus</animation>

            <include>Animation_Common_Fade_In</include>
            <include>Animation_Common_Fade_Out</include>

            <!-- BACKGROUND -->

            <control type="group">
                <top>40</top>
                <left>750</left>
                <height>80</height>

                <control type="group">
                    <control type="image">
                        <width>1090</width>
                        <height>80</height>
                        <include>Texture_Keyboard_Search_Background</include>
                        <animation effect="fade" start="100" end="90" condition="true">Conditional</animation>
                    </control>
                    <control type="image">
                        <width>1090</width>
                        <height>80</height>
                        <texture border="40" colordiffuse="$VAR[Color_Search_Bar_Border]" infill="false">$VAR[border40]</texture>
                        <animation effect="fade" start="100" end="50" condition="true">Conditional</animation>
                    </control>
                </control>
                <control type="group">
                    <top>22</top>
                    <left>24</left>
                    <include>Search_Panel_Keyboard</include>
                </control>
            </control>

            <!-- TIPS - KEYBOARD -->

            <include content="Object_Footer_Tips">
                <param name="top" value="120" />
                <param name="left" value="764" />
                <param name="label" value="$VAR[Label_Feature_Search_Keyboard_Tip]" />
                <param name="id_label" value="89" />
                <param name="textcolor" value="Black70" />
                <param name="colordiffuse" value="$VAR[Color_Icon_Light]" />
                <param name="visible" value="true" />
            </include>
        </control>

        <!-- CONTAINER ROW WIDGETS -->

        <control type="grouplist" id="6000">
            <onup>90009</onup>

            <include>Animation_Common_Global</include>
            <include>Animation_Vertical_Scrolltime_Widgets_Container</include>

            <itemgap>0</itemgap>
            <orientation>vertical</orientation>
            <usecontrolcoords>true</usecontrolcoords>

            <height>770</height>
            <bottom>188</bottom>
            <width>1920</width>

            <include>skinshortcuts-template-search</include>
        </control>
    </controls>
</window>
